#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

void solve() {
    int n;
    cin >> n;
    
    vector<int> counts(32, 0);
    for (int i = 0; i < n; ++i) {
        int val;
        cin >> val;
        if (val > 0) {
            int msb = 31 - __builtin_clz(val);
            counts[msb]++;
        }
    }
    cout << *max_element(counts.begin(), counts.end()) << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    if (cin >> t) {
        while (t--) {
            solve();
        }
    }
    return 0;
}
