#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>> t;
    using ll = long long ;
    while(t--){
        int n ;
        cin>> n;
        vector<ll> v(n);
        long long  maxi=1;
        unordered_map<ll,ll> mp;
        for( int i=0;i<n;i++){
            cin>> v[i];
            mp[v[i]-i]++;
            maxi=max(maxi,mp[v[i]-i]);
        }
        
        
        cout<<n-maxi<< endl;
    }
    return 0;
}
